{
  "name": "css-portal-server",
  "version": "1.0.0",
  "private": true,
  "description": "CSS Staff Portal — release 1 API and static front-end server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=../.env --watch src/index.js",
    "create-admin": "node --env-file-if-exists=../.env scripts/create-admin.js",
    "test": "node --test test/unit.test.js",
    "test:e2e": "node --env-file=../.env --test --test-concurrency=1 test/e2e.test.js",
    "test:ui": "node --env-file=../.env test/ui-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
