# CSS Portal — environment template. Copy to .env and fill in.
# On the VPS this file lives at /opt/css-portal/.env (chmod 600, owner cssportal).
# NEVER commit the real .env or paste the service role key into any browser file.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100
# Public address of the portal (no trailing slash). Must be https in production.
APP_URL=https://portal.REPLACE_ME.co.uk
# nginx sits in front of Node, so trust exactly one proxy hop.
TRUST_PROXY=1

# Supabase → Project Settings → API / API Keys
SUPABASE_URL=https://REPLACE_ME.supabase.co
# Public "anon" (or "publishable") key — safe to send to browsers.
SUPABASE_ANON_KEY=REPLACE_ME
# SECRET "service_role" (or "secret") key — server only. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Staff accounts must use this email domain.
ALLOWED_EMAIL_DOMAIN=nhs.net
